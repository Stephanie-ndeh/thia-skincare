# =============================================================================
# FRONTEND (Vercel) — copy to apps/frontend/.env
# =============================================================================

# URL of the Fastify backend API (Railway)
NUXT_PUBLIC_API_BASE_URL=https://api.thia.cm

# Supabase project URL (found in: Supabase Dashboard > Project Settings > API)
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose in frontend)
NUXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Public URL of this frontend (used for OAuth redirects, sitemap, etc.)
NUXT_PUBLIC_SITE_URL=https://thia.cm

# =============================================================================
# BACKEND (Railway) — copy to apps/backend/.env
# =============================================================================

# Port the Fastify server listens on
PORT=3001

# Runtime environment: development | production
NODE_ENV=development

# Frontend origin allowed by CORS (no trailing slash)
FRONTEND_URL=https://thia.cm

# Supabase project URL (same as frontend)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key — NEVER expose in frontend, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase anon key (used for user-context queries where RLS is desirable)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NotchPay public key (pk_...) — used to initialize payments
NOTCHPAY_PUBLIC_KEY=pk_live_...

# NotchPay private key (sk_...) — used for server-side API calls
NOTCHPAY_PRIVATE_KEY=sk_live_...

# NotchPay webhook secret — used to verify webhook HMAC-SHA256 signatures
NOTCHPAY_WEBHOOK_SECRET=whk_...
